# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o .env no repositório

# ─── Banco de Dados ───────────────────────────────────────────────────────────
# Use um usuário com permissões apenas nas tabelas do sistema (não o postgres superusuário)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/manutencao_db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Gere um secret forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="COLOQUE_UM_SECRET_FORTE_AQUI_MINIMO_64_CHARS"

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL exata do frontend em produção (sem barra no final)
FRONTEND_URL="https://seu-dominio.com.br"

# ─── Cookie Cross-Origin ─────────────────────────────────────────────────────
# Defina como "true" SOMENTE se frontend e backend estiverem em domínios diferentes
# Exemplo: frontend no Vercel (app.vercel.app) + backend no Railway (api.railway.app)
# Se estiverem no mesmo domínio/VPS, deixe como "false"
COOKIE_CROSS_ORIGIN=true

# ─── Seed (criação inicial dos usuários) ─────────────────────────────────────
# Usado apenas UMA VEZ para criar os usuários no banco de produção
# Após rodar o seed, essas variáveis podem ser removidas
SEED_USER1_NAME="Nome do Usuário 1"
SEED_USER1_EMAIL="email1@exemplo.com"
SEED_USER1_PASSWORD="SenhaForte1!"

SEED_USER2_NAME="Nome do Usuário 2"
SEED_USER2_EMAIL="email2@exemplo.com"
SEED_USER2_PASSWORD="SenhaForte2!"
